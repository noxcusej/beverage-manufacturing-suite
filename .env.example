# Supabase (existing)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Ramp — Procurement Dashboard. Server-side only; never prefix these with VITE_,
# which would bundle them into the browser build. See docs/PROCUREMENT.md.
RAMP_CLIENT_ID=
RAMP_CLIENT_SECRET=
RAMP_ENV=demo
# RAMP_API_BASE=
# RAMP_SCOPES=bills:read vendors:read entities:read accounting:read
# RAMP_PROXY_API_KEY=

# Client Portal. The portal tables are service-key only — the anon key above
# cannot read them, by design. See docs/CLIENT_PORTAL.md.
SUPABASE_SERVICE_KEY=
# Guards /api/portal-links and /api/comments. SET THIS BEFORE SHARING A LINK:
# while it is unset those routes are open, and anyone who can reach the
# deployment could mint a portal link to any client's data.
PROCUREMENT_ADMIN_KEY=
# Accounting field names the PORTAL uses to resolve a client (comma-separated).
# Read from the environment rather than the request so a client cannot
# influence how their own scope is computed.
# RAMP_CLIENT_FIELDS=client,client name,customer,brand

# Optional shared key for /api/inventory (existing)
# MAKE_API_KEY=
